# expo junk
node_modules
.expo/
.idea/
frontend/.env
# local virtualenvs
**/.venv/

# junk
.DS_Store

# python junk
__pycache__/
backend/ml/aerial/cache/

# osmnx/overpass response cache
/cache/

# ml/street raw datasets + secrets + training runs (never committed)
backend/ml/street/.env
backend/ml/street/data/
backend/ml/street/runs/
# trained YOLO weights ARE runtime-critical; commit best.pt explicitly
backend/ml/street/weights/*
!backend/ml/street/weights/best.pt

# qa candidate dumps (regenerable via osm_metrics --dump-new-edges)
backend/ml/aerial/qa/*_all.geojson

# tile2net local artifacts (clone is tracked, these are not)
backend/tile2net/runs/
backend/tile2net/uv.lock
backend/tile2net/output/

# data dir: runtime files are tracked; user uploads + big raws are not
data/hazard_photos/
data/user_hazards.csv
backend/cache/

# editor noise
.vscode/

